rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }

    // Shared debts: only the two people named on the record can touch it.
    match /shared/{id} {
      allow read: if verified() && me() in resource.data.emails;
      allow create: if verified()
        && request.resource.data.createdBy == me()
        && me() in request.resource.data.emails
        && request.resource.data.emails.size() == 2
        && request.resource.data.status == 'pending'
        && request.resource.data.amt is number && request.resource.data.amt > 0;
      // The other person accepts/declines; nobody can change amount, dates or parties.
      allow update: if verified() && me() in resource.data.emails && (
        // repayments only on accepted records
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pay'])
          && resource.data.status == 'accepted')
        // accept/decline only by the person who did not create it
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'lenderName', 'borrowerName'])
          && resource.data.status == 'pending'
          && me() != resource.data.createdBy));
      // Creator may withdraw a request that isn't accepted yet.
      allow delete: if verified() && resource.data.createdBy == me()
        && resource.data.status != 'accepted';
    }

    // In-app notifications, readable only by the recipient.
    match /notes/{id} {
      allow read, update, delete: if verified() && resource.data.to == me();
      allow create: if verified() && request.resource.data.text.size() < 300;
    }
  }
}
